<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện Trắc Nghiệm (Multiple Choice Quiz) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:orientation="vertical">

    <!-- ── HEADER BAR ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Nút quay lại -->
        <TextView
            android:id="@+id/btnQuizBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="◀"
            android:textColor="#111827"
            android:textSize="20sp" />

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Trắc Nghiệm"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Bộ đếm câu hỏi -->
        <TextView
            android:id="@+id/tvQuizCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_yellow"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="1 / 5"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── THANH TIẾN TRÌNH ──────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/quizProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="20"
        android:progressBackgroundTint="#E5E7EB"
        android:progressTint="#DC2626" />

    <!-- ── NỘI DUNG CUỘN ────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dòng chủ đề + đồng hồ đếm ngược -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <!-- Tag chủ đề -->
                <TextView
                    android:id="@+id/tvQuizTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_blue"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Từ vựng"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Đồng hồ đếm ngược -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_timer_badge"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱ "
                        android:textSize="13sp"
                        android:textColor="#92400E" />

                    <TextView
                        android:id="@+id/tvQuizTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:30"
                        android:textColor="#92400E"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── KHUNG CÂU HỎI ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nhãn "Câu hỏi" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câu hỏi"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Nội dung câu hỏi -->
                <TextView
                    android:id="@+id/tvQuizQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:text="What is the meaning of the word \'vocabulary\'?"
                    android:textColor="#111827"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Nút nghe phát âm (tuỳ chọn) -->
                <TextView
                    android:id="@+id/btnQuizPlayAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="🔊  Nghe phát âm"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── 4 LỰA CHỌN ─────────────────────────────────────── -->

            <!-- Lựa chọn A -->
            <LinearLayout
                android:id="@+id/optionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quiz_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvLetterA"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOptionA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Từ vựng"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvIconA"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="16sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Lựa chọn B -->
            <LinearLayout
                android:id="@+id/optionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quiz_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvLetterB"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOptionB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Quyển sách"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvIconB"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="16sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Lựa chọn C -->
            <LinearLayout
                android:id="@+id/optionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quiz_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvLetterC"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOptionC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Bảng đen"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvIconC"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="16sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Lựa chọn D -->
            <LinearLayout
                android:id="@+id/optionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quiz_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvLetterD"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_letter_badge"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOptionD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Cái bàn"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvIconD"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="16sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Phản hồi sau khi kiểm tra -->
            <LinearLayout
                android:id="@+id/layoutQuizFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvQuizFeedbackIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvQuizFeedbackText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Chính xác! Rất giỏi!"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── VÙNG NÚT DƯỚI ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nút Kiểm Tra -->
        <Button
            android:id="@+id/btnQuizCheck"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_disabled"
            android:enabled="false"
            android:text="KIỂM TRA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Nút Câu Tiếp Theo (ẩn cho đến khi trả lời xong) -->
        <Button
            android:id="@+id/btnQuizNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_red"
            android:text="CÂU TIẾP THEO ▶"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
