<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flashcardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="86dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_outline"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="‹ Trang chủ"
            android:textAllCaps="false"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:backgroundTint="@null" />
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Button
            android:id="@+id/btnToggleAddForm"
            android:layout_width="92dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_primary_red"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="+ Thêm từ"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Flashcard"
        android:textColor="#151922"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="Ôn tập theo nhịp của bạn"
        android:textColor="#656B75"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:background="@drawable/bg_card_front"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="true">
        <LinearLayout
            android:id="@+id/layoutCardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tvCardWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vocabulary"
                android:textColor="#151922"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvCardType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="(Noun)"
                android:textColor="#B5162B"
                android:textSize="14sp"
                android:textStyle="italic" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Chạm vào thẻ để xem nghĩa"
                android:textColor="#656B75"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutCardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_back"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvCardMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Từ vựng"
                android:textColor="#8F1D2C"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvCardExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Ví dụ: Expanding your vocabulary is essential."
                android:textColor="#5F6670"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chạm vào thẻ để xem lại từ"
                android:textColor="#656B75"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/cardNavigation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnPrevCard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:minWidth="0dp"
            android:text="Từ trước"
            android:textAllCaps="false"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:backgroundTint="@null" />
        <TextView
            android:id="@+id/tvCardCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:gravity="center"
            android:text="Thẻ 1 / 5"
            android:textColor="#242A33"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnNextCard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_red"
            android:minWidth="0dp"
            android:text="Từ tiếp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/addFormScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:visibility="gone">
    <LinearLayout
        android:id="@+id/layoutAddForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_profile_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Thêm từ mới"
            android:textColor="#242A33"
            android:textSize="15sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etNewWord"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.6"
                android:background="@drawable/bg_input"
                android:hint="Từ tiếng Anh (*)"
                android:inputType="textCapSentences"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#151922"
                android:textColorHint="#656B75"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etNewType"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Loại từ"
                android:inputType="textCapSentences"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#151922"
                android:textColorHint="#656B75"
                android:textSize="13sp" />
        </LinearLayout>
        <EditText
            android:id="@+id/etNewMeaning"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Nghĩa tiếng Việt (*)"
            android:inputType="textCapSentences"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#151922"
            android:textColorHint="#656B75"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etNewExample"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Câu ví dụ"
            android:inputType="textCapSentences"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#151922"
            android:textColorHint="#656B75"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btnSaveWord"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_red"
            android:text="Lưu từ vựng"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/savedWordsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Từ đã lưu"
            android:textColor="#1B2028"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chạm để học · Nhấn giữ để xóa"
            android:textColor="#656B75"
            android:textSize="10sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvFlashcards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_white_card"
        android:clipToOutline="true"
        android:divider="#E8EAED"
        android:dividerHeight="1dp"
        android:padding="0dp" />
</LinearLayout>
