<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="82dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chào buổi sáng"
                        android:textColor="#7A808A"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Bắt đầu học nào"
                        android:textColor="#151922"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/homeAvatarContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:clipToOutline="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Mở hồ sơ và đổi ảnh đại diện">
                    <TextView
                        android:id="@+id/tvHomeAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="N"
                        android:textColor="#8F1D2C"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/ivHomeAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Thoát"
                    android:textAllCaps="false"
                    android:textColor="#747A84"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_profile_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiến độ tuần này"
                            android:textColor="#242A33"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Duy trì thói quen học mỗi ngày"
                            android:textColor="#858B94"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#B5162B"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_progress_bar_teal" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 buổi học"
                        android:textColor="#656B75"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 từ vựng đã học"
                        android:textColor="#656B75"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thư viện từ vựng"
                    android:textColor="#1B2028"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textColor="#B5162B"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="158dp"
                        android:layout_height="118dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_profile_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="#F3D9C7"
                            android:gravity="center"
                            android:text="PS"
                            android:textColor="#7B4027"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Play sport"
                            android:textColor="#242A33"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="25 từ   10/25"
                            android:textColor="#858B94"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="158dp"
                        android:layout_height="118dp"
                        android:background="@drawable/bg_profile_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="#E4E0F4"
                            android:gravity="center"
                            android:text="RE"
                            android:textColor="#51457D"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Restaurant"
                            android:textColor="#242A33"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="20 từ   9/20"
                            android:textColor="#858B94"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnOpenCamera"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_outline"
                android:text="Quét từ bằng camera"
                android:textAllCaps="false"
                android:textColor="#5F6670"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Bài tập thực hành"
                android:textColor="#1B2028"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/exerciseFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/filterAll"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Tất cả"
                    android:textAllCaps="false"
                    android:textColor="#616873"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
                <Button
                    android:id="@+id/filterListening"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Nghe"
                    android:textAllCaps="false"
                    android:textColor="#616873"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
                <Button
                    android:id="@+id/filterSpeaking"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Nói"
                    android:textAllCaps="false"
                    android:textColor="#616873"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
                <Button
                    android:id="@+id/filterReading"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Đọc"
                    android:textAllCaps="false"
                    android:textColor="#616873"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
                <Button
                    android:id="@+id/filterWriting"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:text="Viết"
                    android:textAllCaps="false"
                    android:textColor="#616873"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <EditText
                android:id="@+id/etExerciseSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="Tìm bài học"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1B2028"
                android:textColorHint="#656B75"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/exerciseList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include android:id="@+id/btnOpenQuiz" layout="@layout/item_home_exercise" />
                <include android:id="@+id/btnOpenListening" layout="@layout/item_home_exercise" />
                <include android:id="@+id/btnOpenFillBlank" layout="@layout/item_home_exercise" />
                <include android:id="@+id/btnOpenWriting" layout="@layout/item_home_exercise" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExerciseEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_white_card"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="#656B75"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Trang chủ"
            android:textColor="#B5162B"
            android:textSize="11sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnOpenFlashcards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="Bộ thẻ"
            android:textAllCaps="false"
            android:textColor="#737983"
            android:textSize="11sp"
            app:backgroundTint="@null" />
        <Button
            android:id="@+id/btnOpenPractice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="Bài làm"
            android:textAllCaps="false"
            android:textColor="#737983"
            android:textSize="11sp"
            app:backgroundTint="@null" />
        <Button
            android:id="@+id/btnOpenProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="Tôi"
            android:textAllCaps="false"
            android:textColor="#737983"
            android:textSize="11sp"
            app:backgroundTint="@null" />
    </LinearLayout>
</FrameLayout>
