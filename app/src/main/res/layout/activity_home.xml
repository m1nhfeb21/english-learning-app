<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark"
    android:padding="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_red" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/welcome_back"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <!-- Quick access -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/home_navigation"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Hồ sơ -->
        <Button
            android:id="@+id/btnOpenProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/home_profile_shortcut"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"/>

        <!-- Bộ thẻ + Camera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnOpenFlashcards"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/home_flashcard_shortcut"
                android:textAllCaps="false"
                android:textColor="@color/text_gray"
                android:background="@drawable/bg_btn_outline"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnOpenCamera"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/home_camera_shortcut"
                android:textAllCaps="false"
                android:textColor="@color/text_gray"
                android:background="@drawable/bg_btn_outline"
                app:backgroundTint="@null"/>
        </LinearLayout>

        <!-- Section label bài tập -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="Bài tập luyện tập"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Trắc Nghiệm + Điền Từ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnOpenQuiz"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🧩 Trắc Nghiệm"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/bg_primary_red"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnOpenFillBlank"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="✏️ Điền Từ"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/bg_primary_red"
                app:backgroundTint="@null"/>
        </LinearLayout>

        <!-- Luyện Nghe + Luyện Viết -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnOpenListening"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🎧 Luyện Nghe"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_primary"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnOpenWriting"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="📝 Luyện Viết"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_primary"
                app:backgroundTint="@null"/>
        </LinearLayout>

        <!-- Bài làm chung -->
        <Button
            android:id="@+id/btnOpenPractice"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="10dp"
            android:text="@string/home_practice_shortcut"
            android:textAllCaps="false"
            android:textColor="@color/text_gray"
            android:background="@drawable/bg_btn_outline"
            app:backgroundTint="@null"/>

        <!-- Đăng xuất -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/logout"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
