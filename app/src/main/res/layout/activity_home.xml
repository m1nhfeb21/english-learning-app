<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark"
    android:padding="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_red" />
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/welcome_back"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
        <TextView
            android:id="@+id/tvHomeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/preview_status"
            android:textColor="#A0A0A0" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="24dp"
            android:background="@drawable/bg_bottom_sheet"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_description"
                android:textColor="@color/bg_dark"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/planned_features"
                android:lineSpacingExtra="12dp"
                android:textColor="@color/text_gray"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Quick access: original dark theme is preserved. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/home_navigation"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/home_profile_shortcut"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnOpenFlashcards"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/home_flashcard_shortcut"
                android:textAllCaps="false"
                android:textColor="@color/text_gray"
                android:background="@drawable/bg_btn_outline"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnOpenCamera"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/home_camera_shortcut"
                android:textAllCaps="false"
                android:textColor="@color/text_gray"
                android:background="@drawable/bg_btn_outline"
                app:backgroundTint="@null"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenPractice"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/home_practice_shortcut"
            android:textAllCaps="false"
            android:textColor="@color/text_gray"
            android:background="@drawable/bg_btn_outline"
            app:backgroundTint="@null"/>
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/logout"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
