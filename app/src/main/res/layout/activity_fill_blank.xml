<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện Điền Từ (Fill in the Blank) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fillRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:orientation="vertical">

    <!-- ── HEADER BAR ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Nút quay lại -->
        <TextView
            android:id="@+id/btnFillBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="◀"
            android:textColor="#111827"
            android:textSize="20sp" />

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Điền Từ"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Bộ đếm câu hỏi -->
        <TextView
            android:id="@+id/tvFillCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_blue"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="1 / 5"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── THANH TIẾN TRÌNH ──────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/fillProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="20"
        android:progressBackgroundTint="#E5E7EB"
        android:progressTint="#DC2626" />

    <!-- ── NỘI DUNG CUỘN ────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dòng chủ đề + tiến trình điểm số -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFillTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_blue"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Điền từ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Điểm -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_timer_badge"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ "
                        android:textSize="12sp"
                        android:textColor="#92400E" />

                    <TextView
                        android:id="@+id/tvFillScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 điểm"
                        android:textColor="#92400E"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── KHUNG CÂU HỎI ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nhãn hướng dẫn -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điền vào chỗ trống"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Câu có chỗ trống (phần trước blank) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvSentenceBefore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="She has a large "
                        android:textColor="#111827"
                        android:textSize="18sp"
                        android:lineSpacingMultiplier="1.4" />

                    <!-- Ô chỗ trống -->
                    <TextView
                        android:id="@+id/tvBlankSlot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="80dp"
                        android:background="@drawable/bg_answer_box"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="_ _ _ _ _"
                        android:textColor="#9CA3AF"
                        android:textSize="18sp"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/tvSentenceAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" of English words."
                        android:textColor="#111827"
                        android:textSize="18sp"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>

                <!-- Gợi ý nghĩa tiếng Việt -->
                <TextView
                    android:id="@+id/tvFillHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFF7ED"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="💡 Gợi ý: vốn từ vựng, danh từ"
                    android:textColor="#92400E"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ── PHẦN HIỂN THỊ ĐÁP ÁN ──────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đáp án:"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp" />

                <!-- Từ đã chọn (hiển thị ở đây) -->
                <TextView
                    android:id="@+id/tvSelectedWord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_answer_box"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="(chưa chọn)"
                    android:textColor="#9CA3AF"
                    android:textSize="16sp"
                    android:textStyle="italic" />

                <!-- Nút xóa lựa chọn -->
                <TextView
                    android:id="@+id/btnClearWord"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="✕"
                    android:textColor="#DC2626"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- ── KHO TỪ ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn từ phù hợp:"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Hàng chip từ - hàng 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipWord0"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_word_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="vocabulary"
                        android:textColor="#111827"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/chipWord1"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_word_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="grammar"
                        android:textColor="#111827"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/chipWord2"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_word_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="fluency"
                        android:textColor="#111827"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Hàng chip từ - hàng 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipWord3"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_word_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="reading"
                        android:textColor="#111827"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/chipWord4"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_word_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="listening"
                        android:textColor="#111827"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/chipWord5"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_word_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="speaking"
                        android:textColor="#111827"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Phản hồi sau kiểm tra -->
                <LinearLayout
                    android:id="@+id/layoutFillFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvFillFeedbackIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="✓"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvFillFeedbackText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Chính xác!"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── VÙNG NÚT DƯỚI ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nút Kiểm Tra -->
        <Button
            android:id="@+id/btnFillCheck"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_disabled"
            android:enabled="false"
            android:text="KIỂM TRA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Nút Câu Tiếp Theo (ẩn) -->
        <Button
            android:id="@+id/btnFillNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_red"
            android:text="CÂU TIẾP THEO ▶"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
